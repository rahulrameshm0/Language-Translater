{
  "name": "vaylo",
  "version": "1.3.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "deno test --allow-env --node-modules-dir=manual tests/",
    "check:function": "deno check --node-modules-dir=manual supabase/functions/translate/index.ts",
    "test:database": "node tests/database.mjs",
    "format": "prettier --write App.tsx src tests/*.ts tests/*.mjs supabase/functions/translate/*.ts",
    "format:check": "prettier --check App.tsx src tests/*.ts tests/*.mjs supabase/functions/translate/*.ts",
    "eas-build-post-install": "node scripts/check-build-env.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "2.118.0",
    "expo": "~55.0.32",
    "expo-asset": "~55.0.20",
    "expo-clipboard": "~55.0.0",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.0",
    "expo-secure-store": "~55.0.0",
    "expo-speech": "~55.0.18",
    "expo-speech-recognition": "3.1.3",
    "expo-status-bar": "~55.0.0",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/react": "~19.2.0",
    "prettier": "^3.9.10",
    "react-dom": "^19.2.0",
    "react-native-web": "^0.21.4",
    "typescript": "~5.9.2"
  }
}
