{
  "expo": {
    "name": "Vaylo",
    "slug": "three-words-translator",
    "scheme": "threewords",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.threewords.translator",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.threewords.translator",
      "icon": "./assets/icon.png",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Vaylo to record your voice for translation.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "owner": "rahulrameshm0-threewords",
    "extra": {
      "eas": {
        "projectId": "e77aa483-7ec9-46b6-a208-3fa02ab82b7d"
      }
    },
    "icon": "./assets/icon.png"
  }
}
